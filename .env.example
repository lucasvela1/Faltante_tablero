
# Copia este archivo a .env y ajusta los valores según tu entorno

# Establece a 'true' para usar datos falsos (mock data) sin necesidad de API
# Establece a 'false' para conectar a la API MES real
DEMO_MODE=true

# CONFIGURACIÓN API MES (requerida solo si DEMO_MODE=false)
# URL base de la API MES
API_MES=http://tu-api-aqui.com

# Ruta del archivo Excel con el plan de producción
RUTA_EXCEL=\\servidor\ruta\a\tu\archivo.xlsx

# Credenciales del usuario MES
USUARIO=tu_usuario
CONTRASENA=tu_contraseña
# - Cuando DEMO_MODE=true, los valores de API_MES, RUTA_EXCEL, USUARIO y CONTRASENA
#   son ignorados (el proyecto usará datos simulados).
